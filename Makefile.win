# Makefile for Windows (nmake) using Microsoft Visual C++ (MSVC)
# Run from "x64 Native Tools Command Prompt for VS"
#
# Usage:
#   nmake -f Makefile.win              (CPU build)
#   nmake -f Makefile.win test         (Run small test suite)
#   nmake -f Makefile.win clean        (Clean build files)

CXX      = cl
CXXFLAGS = /O2 /std:c++17 /openmp /W3 /EHsc /MD /nologo
INC      = /Iinclude
SRC      = src\network.cpp src\csr_util.cpp src\alg1_cme.cpp src\alg2_state_space.cpp src\alg3_transition.cpp src\alg4_reduction.cpp src\alg5_eigenbasis.cpp src\alg5_eigenbasis_cpu.cpp src\alg6_7_8_fsp.cpp src\alg9_10_11_12_preconditioned_fsp.cpp
BUILD    = build

all: $(BUILD)\cme_cli.exe $(BUILD)\test_small.exe

$(BUILD)\cme_cli.exe: apps\cme_cli.cpp $(SRC) | $(BUILD)
	$(CXX) $(CXXFLAGS) $(INC) apps\cme_cli.cpp $(SRC) /Fe:$@

$(BUILD)\test_small.exe: tests\test_small.cpp $(SRC) | $(BUILD)
	$(CXX) $(CXXFLAGS) $(INC) tests\test_small.cpp $(SRC) /Fe:$@

$(BUILD):
	if not exist $(BUILD) mkdir $(BUILD)

test: $(BUILD)\test_small.exe
	$(BUILD)\test_small.exe

clean:
	if exist $(BUILD) rmdir /s /q $(BUILD)
	if exist *.obj del /q *.obj

# ==============================================================================
# Dedicated runners for each Thesis Algorithm (1 through 12)
# ==============================================================================
NETWORK = examples\michaelis_menten.net
OUT_DIR = out

run-alg1: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 1 --out $(OUT_DIR)\alg1

run-alg2: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 2 --out $(OUT_DIR)\alg2

run-alg3: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 3 --out $(OUT_DIR)\alg3

run-alg4: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 4 --d 4 --solve-time 0.1 --out $(OUT_DIR)\alg4

run-alg5: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 5 --d 4 --out $(OUT_DIR)\alg5

run-alg6: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 6 --tf 0.1 --eps 1e-4 --out $(OUT_DIR)\alg6

run-alg7: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 7 --tf 0.1 --num-steps 5 --eps 1e-4 --out $(OUT_DIR)\alg7

run-alg8: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 8 --tf 0.1 --eps 1e-4 --out $(OUT_DIR)\alg8

run-alg9: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 9 --d 4 --tf 0.5 --eps 1e-4 --t-eps 0.01 --out $(OUT_DIR)\alg9

run-alg10: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 10 --d 4 --eps 1e-4 --t-eps 0.01 --out $(OUT_DIR)\alg10

run-alg11: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 11 --d 4 --eps 1e-4 --t-eps 0.01 --out $(OUT_DIR)\alg11

run-alg12: $(BUILD)\cme_cli.exe
	@if not exist $(OUT_DIR) mkdir $(OUT_DIR)
	$(BUILD)\cme_cli.exe $(NETWORK) --alg 12 --d 4 --tf 0.5 --eps 1e-4 --t-eps 0.01 --out $(OUT_DIR)\alg12

run-all-algs: run-alg1 run-alg2 run-alg3 run-alg4 run-alg5 run-alg6 run-alg7 run-alg8 run-alg9 run-alg10 run-alg11 run-alg12

init:
	call utils\setup_prereqs.bat

